# API Keys
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Twilio Configuration (for Phone-based Calls)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# Deepgram Configuration (for Speech Recognition & TTS)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Base URL for Twilio Webhooks
BASE_URL=https://your-domain.com

# Daily.co Configuration (for WebRTC - Legacy)
DAILY_API_KEY=your_daily_api_key_here

# Server Configuration
PORT=8000
HOST=0.0.0.0
DEBUG=True

# CORS Origins
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# RAG Configuration
CHROMA_PERSIST_DIRECTORY=./data/chroma
UPLOAD_DIRECTORY=./data/uploads

# Voice Configuration
TTS_VOICE_ID=21m00Tcm4TlvDq8ikWAM  # ElevenLabs Rachel voice
VAD_THRESHOLD=0.5
